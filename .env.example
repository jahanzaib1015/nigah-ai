# The only vision provider: Google Gemini (gemini-3.6-flash).
# Without this key the backend refuses to start, because no scan could be
# answered and the app would only ever say "pehchan nahi ho saki".
# GEMINI_API_KEY=your_google_gemini_api_key

# There is no second provider, no fallback chain and no test-data mode. A scan
# either returns what Gemini actually read, or it fails honestly.

# Optional, and only read by `python app.py` to switch Flask's debug reloader
# off. Production runs gunicorn (see Procfile and railway.json), so it has no
# effect on a Railway deployment.
# APP_MODE=production
