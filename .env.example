# Vision providers. Both stay wired up whenever their credentials exist;
# APP_MODE only decides which one the chain tries first. The values are
# commented out on purpose: a copied template with placeholders in it would
# look like a configured provider and burn the chain budget on a bogus URL.
# GEMINI_API_KEY=your_google_gemini_api_key
# TABI_API_KEY=your_dev_key_here
# TABI_BASE_URL=https://your-dev-endpoint

# production tries Google first, development (the default) tries TabiAI first.
# APP_MODE=development

# On by default. When every provider is missing or failing, scans answer with
# stable test data instead of a 503, and each answer labels itself: a TEST DATA
# badge on screen, a spoken Urdu notice, and an is_mock flag on the saved row.
# Set to 0 to make the app strict again and speak the service-down message.
# MOCK_VISION=0

# With nothing set above, the app still boots and both scanners work end to
# end on labelled test data.
